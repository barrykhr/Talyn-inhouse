// Talyn In-house TA — data model (Phase 1 recruiting workspace + Phase 2 sourcing & outreach).
// Every business record carries `orgId`; all reads/writes are scoped by it on the server.
// Enum-like fields are strings; allowed values live in src/lib/domain.ts and are validated with zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Migrations run with DATABASE_URL_UNPOOLED when it is set (Neon); see the vercel-build script.
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String       @id @default(cuid())
  name                  String
  retentionDays         Int? // candidates inactive for longer are eligible for deletion; null = keep until deleted
  atsLinkedAt           DateTime? // set when an admin links this workspace to the configured ATS (one workspace per ATS)
  atsLinkedBy           String?
  // How candidates can ask for an alternative assessment; recruiters share it in job ads and outreach.
  accommodationText     String       @default("")
  // Aggregate fairness monitoring with self-reported data. Off until an admin attests it is lawful.
  demographicMonitoring Boolean      @default(false)
  demographicAttestedBy String?
  demographicAttestedAt DateTime?
  // Interview recording & transcription: off until an admin turns it on with the consent policy.
  recordingEnabled      Boolean      @default(false)
  recordingPolicy       String       @default("")
  recordingEnabledBy    String?
  recordingEnabledAt    DateTime?
  createdAt             DateTime     @default(now())
  memberships           Membership[]
  sessions              Session[]
  roles                 Role[]
  candidates            Candidate[]
  atsSyncRuns           AtsSyncRun[]
  invites               Invite[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String? // null for accounts that sign in with Google only
  googleSub    String?      @unique // Google account id ("sub" claim)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String       @default("admin") // admin | recruiter | hiring_manager
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// A verified Google identity waiting for its workspace to be created (new users only).
model PendingSignup {
  id        String   @id // sha256 of the cookie token
  googleSub String
  email     String
  name      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String       @id // sha256 of the cookie token; the raw token is never stored
  userId    String
  orgId     String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id                 String           @id @default(cuid())
  orgId              String
  title              String
  department         String           @default("")
  location           String           @default("")
  employmentType     String           @default("full_time")
  description        String           @default("")
  status             String           @default("draft") // draft | open | on_hold | closed
  criteriaVersion    Int              @default(1) // bumped whenever the approved criteria set changes
  // Skill matching rubric (recruiter-configured; applied live, never used to reject or hide anyone)
  skillThreshold     Int? // minimum number of required skills with "Evidence found"
  skillPartialCredit Boolean          @default(false) // count "Partial evidence" toward the threshold
  weightRequired     Int              @default(2) // evaluation-criteria weights used in the alignment calculation
  weightPreferred    Int              @default(1)
  rubricUpdatedBy    String?
  rubricUpdatedAt    DateTime?
  extractionStatus   String? // null | needs_review | reviewed (when created from an uploaded JD)
  atsExternalId      String? // job/requisition id in the connected ATS
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  org                Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  criteria           Criterion[]
  applications       Application[]
  documents          JobDescription[]
  extracted          ExtractedField[]
  icps               Icp[]
  searches           SearchStrategy[]
  questions          Question[]
  atsStageMaps       AtsStageMap[]
  discoveryBrief     DiscoveryBrief?
  scoringVersions    ScoringVersion[]

  @@index([orgId])
}

// An uploaded job description (PDF/DOCX) with its extracted per-page text.
model JobDescription {
  id            String              @id @default(cuid())
  orgId         String
  roleId        String
  fileName      String
  mimeType      String
  sizeBytes     Int
  pagesJson     String // JSON string[]: extracted text per page
  parserVersion String
  isCurrent     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  role          Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  file          JobDescriptionFile?

  @@index([orgId, roleId])
}

model JobDescriptionFile {
  id    String         @id @default(cuid())
  jdId  String         @unique
  orgId String
  data  Bytes
  jd    JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
}

// A single fact extracted from a JD or CV, with its source and review state.
model ExtractedField {
  id               String     @id @default(cuid())
  orgId            String
  subjectType      String // role | candidate
  roleId           String?
  candidateId      String?
  documentId       String? // JobDescription.id or Resume.id it came from
  field            String // e.g. title, location, email, work_history, skill
  valueJson        String // extracted value (string or object)
  editedValueJson  String? // recruiter-corrected value
  correctionReason String? // why the recruiter corrected it (see CORRECTION_REASONS)
  sourceQuote      String?
  sourcePage       Int?
  sourceSection    String?
  verified         Boolean    @default(false) // sourceQuote found in the document text
  status           String     @default("pending") // pending | accepted | edited | rejected
  extractor        String // e.g. "ai:openai:gpt-5.5/jd-extract-v1", "parser:jd-heuristic-v1"
  reviewedByName   String?
  reviewedAt       DateTime?
  position         Int        @default(0)
  createdAt        DateTime   @default(now())
  role             Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidate        Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([orgId, roleId])
  @@index([orgId, candidateId])
}

model Criterion {
  id                  String           @id @default(cuid())
  orgId               String
  roleId              String
  name                String
  description         String           @default("")
  importance          String           @default("essential") // essential (shown as "Required") | preferred | informational (criteria only; never weighted)
  kind                String           @default("criterion") // skill | criterion
  aliases             String           @default("") // skills: other names that count as the same skill, comma-separated (recruiter-entered)
  mappedCriterionId   String? // skills: the evaluation criterion this skill supports (recruiter-chosen)
  priority            Int?
  origin              String           @default("manual") // manual | ai | extracted
  originalName        String? // wording as first proposed (AI or extraction), for edit comparison
  originalDescription String?
  edited              Boolean          @default(false)
  sourceText          String? // excerpt of the job description this came from
  sourcePage          Int?
  sourceSection       String?
  rationale           String?
  status              String           @default("proposed") // proposed | approved | rejected
  approvedById        String?
  approvedAt          DateTime?
  position            Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  role                Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assessmentItems     AssessmentItem[]

  @@index([orgId, roleId])
}

model Candidate {
  id                     String              @id @default(cuid())
  orgId                  String
  fullName               String
  email                  String?
  phone                  String?
  location               String?
  linkedinUrl            String?
  currentTitle           String?
  currentCompany         String?
  candidateSummary       String? // information provided by the candidate (e.g. application answers)
  source                 String              @default("manual") // manual | csv | cv_upload
  fieldOriginsJson       String              @default("{}") // { fieldName: "cv" | "cv_corrected" | "recruiter" }
  extractionStatus       String? // null | needs_review | reviewed (when a CV extraction awaits review)
  isSample               Boolean             @default(false) // fictional person from Talyn sample data (demo only)
  contactOptOut          Boolean             @default(false) // candidate asked not to be contacted: blocks all outreach
  optOutAt               DateTime?
  atsExternalId          String? // id in the connected ATS (set by ATS sync)
  atsSyncedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  org                    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resumes                Resume[]
  notes                  Note[]
  applications           Application[]
  extracted              ExtractedField[]
  atsConflicts           AtsConflict[]
  duplicatesAsA          DuplicateReview[]   @relation("DuplicateA")
  duplicatesAsB          DuplicateReview[]   @relation("DuplicateB")
  demographics           DemographicRecord[]
  // WhatsApp needs channel-specific, recorded permission before Talyn can send on it.
  whatsappPermission     String              @default("none") // none | granted | withdrawn
  whatsappPermissionAt   DateTime?
  whatsappPermissionNote String? // how it was obtained (recruiter-entered)
  whatsappPermissionBy   String?

  @@index([orgId])
  @@index([orgId, email])
}

model Resume {
  id            String       @id @default(cuid())
  orgId         String
  candidateId   String
  fileName      String
  mimeType      String
  sizeBytes     Int          @default(0)
  hasFile       Boolean      @default(false) // true when the original upload is stored in ResumeFile
  parserVersion String       @default("text-v1")
  pagesJson     String // JSON string[] of extracted text, one entry per page
  isCurrent     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  file          ResumeFile? // original upload; null when the resume was pasted as text
  assessments   Assessment[]

  @@index([orgId, candidateId])
}

// Original resume bytes, kept in a separate table so normal resume queries never load them.
// Stored in Postgres (private, deleted with the resume) — no public file storage involved.
model ResumeFile {
  id       String @id @default(cuid())
  resumeId String @unique
  orgId    String
  data     Bytes
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Note {
  id          String    @id @default(cuid())
  orgId       String
  candidateId String
  roleId      String?
  authorId    String?
  authorName  String    @default("")
  body        String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([orgId, candidateId])
}

// A candidate's association with a role, and their place in that role's pipeline.
model Application {
  id               String             @id @default(cuid())
  orgId            String
  candidateId      String
  roleId           String
  stage            String             @default("new")
  origin           String             @default("applied") // applied (inbound) | discovered (found by a recruiter in Discover)
  originDetail     String? // e.g. "Saved from Discover · Talyn rediscovery"
  sourcedProfileId String? // the Discover result this came from, if discovered
  decision         String? // advance | hold | decline — always recorded by a recruiter
  decisionNote     String?
  decisionReason   String? // structured reason, required for "reject" (decline)
  decidedById      String?
  decidedByName    String?
  decidedAt        DateTime?
  priority         Int                @default(0) // recruiter override: 1 high, 0 normal, -1 low. Never changes the stage.
  priorityNote     String?
  priorityByName   String?
  priorityAt       DateTime?
  atsExternalId    String? // application id in the connected ATS
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  candidate        Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  role             Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  stageEvents      StageEvent[]
  assessments      Assessment[]
  tasks            Task[]
  outreach         OutreachSequence[]
  questions        Question[]
  atsOutbox        AtsOutbox[]
  // What the candidate has actually said about this role. Never inferred.
  interest         String             @default("not_expressed") // not_expressed | interested | not_now | declined
  interestAt       DateTime?
  interestByName   String?
  interestNote     String?
  interestChannel  String? // how the candidate said it: email | whatsapp | phone | in_person | application | other
  interestSource   String? // where/when, in the recruiter's words (e.g. "reply to email of 3 Oct")
  interviewKit     InterviewKit?
  profileScores    ProfileScore[]
  // Alternative assessment route, recorded when a candidate asks for it or the recruiter judges the
  // screen may not assess them accurately. Never asks for or records the reason (e.g. disability).
  altRoute         String             @default("none") // none | requested | in_progress | completed
  altRouteNote     String?
  altRouteBy       String?
  altRouteAt       DateTime?

  @@unique([candidateId, roleId])
  @@index([orgId, roleId])
}

model StageEvent {
  id            String      @id @default(cuid())
  orgId         String
  applicationId String
  fromStage     String?
  toStage       String
  actorId       String?
  actorName     String      @default("")
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Assessment {
  id                       String           @id @default(cuid())
  orgId                    String
  applicationId            String
  resumeId                 String?
  generator                String // "ai" | "keyword" | "manual"
  model                    String? // model id when generator = ai
  criteriaSnapshot         String // JSON: [{id, updatedAt}] of the approved criteria used
  criteriaVersion          Int?
  engineVersion            String? // assessment prompt/logic version
  parserVersion            String? // resume text parser version
  profileHash              String? // fingerprint of the candidate-provided information used (detects later edits)
  sourceProfileId          String? // linked Discover source record used as evidence, if any
  scoreJson                String? // score breakdown at generation time (see src/lib/score.ts)
  recommendation           String? // advance_to_review | gather_more_info | insufficient_evidence
  recommendationJson       String? // { rationale, criteriaCited[], questions[], adjustedNote }
  recommendationStatus     String? // pending | accepted | edited | overridden
  finalRecommendation      String?
  recommendationNote       String?
  recommendationReviewedBy String?
  recommendationReviewedAt DateTime?
  status                   String           @default("needs_review") // needs_review | reviewed
  createdById              String?
  reviewedById             String?
  reviewedByName           String?
  reviewedAt               DateTime?
  createdAt                DateTime         @default(now())
  application              Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume                   Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  items                    AssessmentItem[]
  profileScores            ProfileScore[]

  @@index([orgId, applicationId])
}

model AssessmentItem {
  id             String                 @id @default(cuid())
  assessmentId   String
  criterionId    String?
  criterionName  String // snapshot so history survives criterion edits
  importance     String
  kind           String                 @default("criterion") // skill | criterion (snapshot)
  result         String // supported | partially_supported | inferred | conflicting | not_stated
  evidenceJson   String                 @default("[]") // JSON: [{quote, source, page, section, verified}]
  explanation    String                 @default("")
  missingInfo    String                 @default("")
  confidence     String? // high | medium | low
  overrideResult String? // recruiter correction
  overrideNote   String?
  overriddenBy   String?
  overriddenAt   DateTime?
  assessment     Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion      Criterion?             @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  corrections    AssessmentCorrection[]

  @@index([assessmentId])
}

/// Every recruiter correction to an assessment item, append-only. The engine's original result
/// stays on the item; the item's override fields hold the current correction.
model AssessmentCorrection {
  id             String         @id @default(cuid())
  orgId          String
  itemId         String
  assessmentId   String
  applicationId  String
  kind           String         @default("criterion") // skill | criterion (snapshot)
  criterionName  String
  engineResult   String // what the assessment engine produced (never changes)
  fromResult     String? // correction in effect before this change (null = engine result)
  toResult       String? // correction after this change (null = cleared back to the engine result)
  fromNote       String?
  note           String?
  restoredFromId String? // set when this change restored an earlier correction
  byId           String?
  byName         String
  createdAt      DateTime       @default(now())
  item           AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([itemId, createdAt])
}

/// A possible duplicate pair, reviewed by a recruiter. Nothing is merged or deleted: "linked"
/// records that two records are the same person while keeping both, and can be undone.
model DuplicateReview {
  id            String    @id @default(cuid())
  orgId         String
  candidateAId  String // lower id of the pair
  candidateBId  String
  reasonsJson   String    @default("[]") // ["Same email (normalized)", ...]
  confidence    String // high | medium | low
  status        String    @default("open") // open | linked | dismissed | deferred
  note          String?
  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  candidateA    Candidate @relation("DuplicateA", fields: [candidateAId], references: [id], onDelete: Cascade)
  candidateB    Candidate @relation("DuplicateB", fields: [candidateBId], references: [id], onDelete: Cascade)

  @@unique([orgId, candidateAId, candidateBId])
  @@index([orgId, status])
}

// Append-only record of meaningful actions (access, export, assessment, decision, outreach…).
// metaJson holds ids and counts only — never candidate personal data or document text.
model AuditEvent {
  id            String   @id @default(cuid())
  orgId         String
  actorId       String?
  actorName     String   @default("")
  action        String // e.g. candidate.viewed, resume.downloaded, export.pipeline, assessment.run
  subjectType   String // candidate | role | application | assessment | outreach | sourcing | org
  subjectId     String?
  roleId        String?
  candidateId   String?
  applicationId String?
  metaJson      String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, candidateId])
  @@index([orgId, action])
}

// Recruiter tasks, e.g. "Gather more information". Completing or cancelling a task never
// records a hiring decision.
model Task {
  id              String      @id @default(cuid())
  orgId           String
  applicationId   String
  type            String // gather_info | send_outreach
  title           String
  detailsJson     String      @default("{}") // { questions: string[], criteria: string[], messageId? }
  status          String      @default("open") // open | done | cancelled
  dueAt           DateTime?
  createdById     String?
  createdByName   String      @default("")
  resolvedNote    String?
  resolvedByName  String?
  resolvedAt      DateTime?
  // Assistant follow-up: the questions sent to the candidate after recruiter approval.
  agentStatus     String? // drafted | sent | replied | answered | failed
  agentChannel    String? // whatsapp | email
  agentSubject    String?
  agentDraft      String?
  agentDraftedBy  String? // ai:<model> | template
  agentApprovedBy String?
  agentSentAt     DateTime?
  agentSentVia    String? // provider label, or "manual"
  agentProviderId String?
  agentTo         String? // number or address it was sent to
  agentError      String?
  agentReplyAt    DateTime?
  agentReplyVia   String? // WhatsApp (provider-confirmed) | Email provider | recruiter
  createdAt       DateTime    @default(now())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([applicationId])
  @@index([agentProviderId])
}

// Ideal Candidate Profile: the recruiter-approved description of who to look for. Versioned;
// only an approved version drives sourcing. Ambiguity becomes clarification questions, never filters.
model Icp {
  id                 String    @id @default(cuid())
  orgId              String
  roleId             String
  version            Int
  status             String    @default("draft") // draft | approved | superseded
  generator          String // e.g. "ai:openai:gpt-5.5/icp-v1", "parser:icp-from-criteria-v1"
  criteriaVersion    Int
  clarificationsJson String    @default("[]") // [{ question, why, answer? }]
  approvedByName     String?
  approvedAt         DateTime?
  createdByName      String    @default("")
  createdAt          DateTime  @default(now())
  role               Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  items              IcpItem[]

  @@unique([roleId, version])
  @@index([orgId, roleId])
}

model IcpItem {
  id          String  @id @default(cuid())
  icpId       String
  category    String // see ICP_CATEGORIES in src/lib/domain.ts
  value       String
  origin      String // jd | criteria | ai_inferred | recruiter
  rationale   String?
  sourceQuote String?
  sourcePage  Int?
  status      String  @default("proposed") // proposed | approved | rejected
  edited      Boolean @default(false)
  position    Int     @default(0)
  icp         Icp     @relation(fields: [icpId], references: [id], onDelete: Cascade)

  @@index([icpId])
}

// A saved, versioned search plan for a role, derived from an approved ICP (+ optional
// plain-language request). Filters and Boolean are recruiter-editable.
model SearchStrategy {
  id               String      @id @default(cuid())
  orgId            String
  roleId           String
  icpId            String? // null when the recruiter searched directly from Discover
  icpVersion       Int?
  version          Int
  request          String      @default("") // recruiter's plain-language request
  filtersJson      String // { titles, skills_required, skills_preferred, locations, seniority, industries, exclusions }
  booleanQuery     String      @default("")
  mappingJson      String      @default("[]") // [{ phrase, field, value, note }]
  explanationsJson String      @default("[]") // [{ term, why }]
  planJson         String      @default("{}") // { target_titles, adjacent_profiles, company_contexts, notes }
  generator        String
  createdByName    String      @default("")
  createdAt        DateTime    @default(now())
  role             Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  runs             SearchRun[]

  @@unique([roleId, version])
  @@index([orgId, roleId])
}

model SearchRun {
  id             String           @id @default(cuid())
  orgId          String
  roleId         String
  strategyId     String
  source         String // connector key, e.g. "talyn"
  status         String // completed | failed | setup_required
  query          String           @default("") // the source-specific query actually used
  resultCount    Int              @default(0)
  excludedCount  Int              @default(0)
  estimatedTotal Int? // only when the source provides one
  error          String?
  createdByName  String           @default("")
  createdAt      DateTime         @default(now())
  strategy       SearchStrategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  results        SourcedProfile[]
  isDemo         Boolean          @default(false) // sample data — never a live search
  sourcesJson    String           @default("[]") // [{ key, label, status: ok|error|setup_required, count, error }]

  @@index([orgId, roleId])
}

// A candidate profile returned by an authorized source for a specific run. Facts keep
// field-level provenance; match signals are evidence-backed and never an assessment.
model SourcedProfile {
  id                   String    @id @default(cuid())
  orgId                String
  roleId               String
  runId                String
  source               String
  sourceRecordId       String // id in the source system (for Talyn rediscovery: the candidate id)
  sourceUrl            String?
  retrievedAt          DateTime  @default(now())
  displayName          String
  currentTitle         String?
  currentCompany       String?
  location             String?
  fieldsJson           String    @default("{}") // { field: { value, source, asOf } }
  signalsJson          String    @default("[]") // [{ category, term, matched, quote, page }]
  matchedSignals       Int       @default(0)
  totalSignals         Int       @default(0)
  evidenceStatus       String    @default("ok") // ok | insufficient | stale
  staleReason          String?
  duplicateCandidateId String?
  duplicateReason      String?
  status               String    @default("new") // new | saved | dismissed | excluded
  excludedBy           String? // approved exclusion term that matched
  feedback             String? // useful | irrelevant
  feedbackReason       String?
  savedApplicationId   String?
  reviewedByName       String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  run                  SearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourcesJson          String    @default("[]") // every source this person was found in: [{ key, label, url, recordId, retrievedAt }]

  @@index([orgId, roleId, status])
  @@index([runId])
}

model OutreachTemplate {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  subject       String
  body          String // may contain {{first_name}} {{role_title}} {{company}} {{current_title}}
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
}

// A recruiter-approved, role-specific outreach sequence for one application. Nothing is
// sent unless a recruiter activates it; replies, opt-outs and bounces stop follow-ups.
model OutreachSequence {
  id              String    @id @default(cuid())
  orgId           String
  applicationId   String
  status          String    @default("draft") // draft | active | paused | stopped | completed
  stopReason      String? // replied | opted_out | bounced | recruiter
  activatedByName String?
  activatedAt     DateTime?
  createdByName   String    @default("")
  createdAt       DateTime  @default(now())

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    OutreachMessage[]
  events      OutreachEvent[]
  channel     String            @default("email") // email | whatsapp

  @@index([orgId, status])
  @@index([applicationId])
}

model OutreachMessage {
  id                  String           @id @default(cuid())
  orgId               String
  sequenceId          String
  applicationId       String
  step                Int
  delayDays           Int              @default(0) // after the previous step was sent
  subject             String
  body                String
  draftSubject        String // as first drafted (AI or template), to show recruiter edits
  draftBody           String
  personalizationJson String           @default("[]") // [{ key, label, value, source }]
  generator           String // ai:<provider>:<model>/outreach-v1 | template:<id> | recruiter
  status              String           @default("draft") // draft | approved | due | sent | delivered | replied | bounced | opted_out | cancelled
  approvedByName      String?
  approvedAt          DateTime?
  dueAt               DateTime?
  sentAt              DateTime?
  sentVia             String? // manual | <provider key>
  providerMessageId   String?
  toEmail             String?
  senderName          String?
  deliveredAt         DateTime? // only when the provider reports delivery
  createdAt           DateTime         @default(now())
  sequence            OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  toPhone             String? // WhatsApp recipient, set when sent

  @@index([orgId, status])
  @@index([sequenceId])
  @@index([providerMessageId])
}

model OutreachEvent {
  id                String           @id @default(cuid())
  orgId             String
  sequenceId        String
  messageId         String?
  type              String // drafted | approved | activated | paused | resumed | stopped | sent | delivered | replied | bounced | opted_out
  providerConfirmed Boolean          @default(false) // true only when the sending provider reported it
  note              String?
  actorName         String           @default("")
  createdAt         DateTime         @default(now())
  sequence          OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
}

// Recruiter questions tied to a role criterion. Core questions (applicationId = null) are the
// same for every candidate in the role; follow-ups are candidate-specific and tied to an
// evidence gap or quote. Never sent to candidates automatically.
model Question {
  id            String       @id @default(cuid())
  orgId         String
  roleId        String
  criterionId   String?
  criterionName String
  applicationId String?
  kind          String // core | follow_up
  text          String
  rationale     String       @default("")
  evidenceJson  String       @default("{}") // { gap?: string, quote?: string, page?: number }
  origin        String // ai | template | recruiter
  generator     String       @default("")
  status        String       @default("proposed") // proposed | approved | rejected
  createdByName String       @default("")
  createdAt     DateTime     @default(now())
  role          Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, roleId])
  @@index([applicationId])
}

// ── ATS sync (dormant until an ATS connector is configured) ──────────────────

model AtsSyncRun {
  id          String       @id @default(cuid())
  orgId       String
  connector   String
  kind        String // pull | push
  status      String // running | completed | partial | failed
  created     Int          @default(0)
  updated     Int          @default(0)
  unchanged   Int          @default(0)
  conflicts   Int          @default(0)
  errorsJson  String       @default("[]") // [{ externalId?, message }] — no candidate data
  triggeredBy String       @default("") // cron | <user name>
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
}

/// A field where the ATS and Talyn disagree and Talyn would not overwrite a recruiter's value.
model AtsConflict {
  id             String    @id @default(cuid())
  orgId          String
  candidateId    String
  externalId     String
  field          String
  talynValue     String
  atsValue       String
  status         String    @default("open") // open | kept_talyn | used_ats
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([candidateId])
}

/// Per-role mapping of Talyn stages to ATS stages. atsStage null = not synced.
model AtsStageMap {
  id         String  @id @default(cuid())
  orgId      String
  roleId     String
  talynStage String
  atsStage   String?
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, talynStage])
  @@index([orgId])
}

/// Recruiter-made stage changes waiting to be pushed to the ATS. Retried with backoff.
model AtsOutbox {
  id            String      @id @default(cuid())
  orgId         String
  applicationId String
  roleId        String
  talynStage    String
  atsStage      String
  status        String      @default("pending") // pending | sent | failed | skipped
  attempts      Int         @default(0)
  lastError     String?
  nextAttemptAt DateTime    @default(now())
  createdByName String      @default("")
  createdAt     DateTime    @default(now())
  sentAt        DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([status, nextAttemptAt])
}

/// The fields a Discover search is built from, per role. Extracted from the JD or entered by a
/// recruiter, always reviewed and editable. Provenance per field lives in provenanceJson.
model DiscoveryBrief {
  id                  String    @id @default(cuid())
  orgId               String
  roleId              String    @unique
  origin              String // jd | manual
  roleName            String
  altTitlesJson       String    @default("[]")
  skillsRequiredJson  String    @default("[]")
  skillsPreferredJson String    @default("[]")
  exclusionsJson      String    @default("[]")
  minYears            Int?
  maxYears            Int?
  location            String?
  workArrangement     String? // onsite | hybrid | remote
  provenanceJson      String    @default("{}") // { field: { status: from_jd|inferred|not_stated|edited|manual, quote, page, verified, items? } }
  booleanQuery        String    @default("")
  booleanEdited       Boolean   @default(false) // recruiter edited the generated query
  booleanFieldsKey    String? // fields the query was generated from, to flag when it is out of date
  extractor           String?
  jdId                String?
  confirmedAt         DateTime?
  confirmedByName     String?
  updatedByName       String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  role                Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Invitation to join a workspace. The link token is stored only as a SHA-256 hash.
model Invite {
  id            String       @id @default(cuid())
  tokenHash     String       @unique
  orgId         String
  email         String
  name          String
  role          String // recruiter | hiring_manager | admin
  invitedByName String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ── Interviews (Phase 3, first slice): kit → stages → interviewer scorecards → debrief ──

/// The interview plan for one candidate in one role. Competencies come from the role's criteria.
model InterviewKit {
  id                String                @id @default(cuid())
  orgId             String
  applicationId     String                @unique
  roleId            String
  candidateId       String
  status            String                @default("draft") // draft | shared
  generator         String                @default("recruiter") // ai:<provider>:<model>/kit-v1 | template:kit-v1 | recruiter
  criteriaVersion   Int?
  ownerId           String // recruiter who created it; can record the team decision
  ownerName         String
  hiringManagerId   String?
  sharedAt          DateTime?
  sharedByName      String?
  // The team decision after the debrief — always recorded by a person, separate from scores.
  decision          String? // advance | hold | decline
  decisionRationale String?
  decidedById       String?
  decidedByName     String?
  decidedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  application       Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  competencies      InterviewCompetency[]
  stages            InterviewStage[]
  comments          DebriefComment[]

  @@index([orgId, roleId])
}

model InterviewCompetency {
  id            String              @id @default(cuid())
  kitId         String
  criterionId   String? // null when added by a recruiter for this kit
  name          String
  description   String              @default("")
  importance    String              @default("essential") // essential | preferred
  position      Int                 @default(0)
  anchorsJson   String              @default("{}") // { "1": "...", "2": "...", "3": "...", "4": "..." } behavioral anchors
  origin        String              @default("criteria") // criteria | recruiter
  anchorsOrigin String              @default("template") // ai | template | recruiter
  kit           InterviewKit        @relation(fields: [kitId], references: [id], onDelete: Cascade)
  questions     InterviewQuestion[]

  @@index([kitId])
}

model InterviewQuestion {
  id           String              @id @default(cuid())
  competencyId String
  kitId        String
  text         String
  followUps    String              @default("") // optional follow-up prompts, one per line
  guidance     String              @default("") // optional interviewer notes: what good evidence looks like
  position     Int                 @default(0)
  origin       String // ai | template | core_question | recruiter
  edited       Boolean             @default(false)
  competency   InterviewCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@index([kitId])
}

model InterviewStage {
  id                String                @id @default(cuid())
  kitId             String
  name              String
  purpose           String                @default("")
  position          Int                   @default(0)
  competencyIdsJson String                @default("[]")
  // Scheduling is manual: these are what the recruiter entered. Talyn doesn't book meetings or send invites.
  scheduledAt       DateTime?
  durationMins      Int?
  locationNote      String?
  kit               InterviewKit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  assignments       InterviewAssignment[]
  scheduling        InterviewScheduling?
  events            InterviewEvent[]
  recordings        InterviewRecording[]

  @@index([kitId])
}

/// One interviewer on one stage, and their scorecard.
model InterviewAssignment {
  id                String         @id @default(cuid())
  kitId             String
  stageId           String
  interviewerId     String
  interviewerName   String
  assignedByName    String
  status            String         @default("not_started") // not_started | draft | submitted
  entriesJson       String         @default("[]") // [{ competencyId, rating: 1-4|null, notAssessed, evidence }]
  questionNotesJson String         @default("{}") // { questionId: note }
  notes             String         @default("") // role-relevant notes only
  savedAt           DateTime?
  submittedAt       DateTime?
  createdAt         DateTime       @default(now())
  stage             InterviewStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, interviewerId])
  @@index([interviewerId, status])
  @@index([kitId])
}

model DebriefComment {
  id         String       @id @default(cuid())
  kitId      String
  authorId   String
  authorName String
  body       String
  kind       String       @default("comment") // comment | decision
  createdAt  DateTime     @default(now())
  kit        InterviewKit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId])
}

/// A user's Google Calendar authorization. Tokens are encrypted at rest (AES-256-GCM) and never
/// leave the server. Only free/busy and events Talyn creates are used.
model CalendarConnection {
  id              String    @id @default(cuid())
  orgId           String
  userId          String
  provider        String    @default("google")
  googleEmail     String
  scopes          String    @default("") // as granted by Google
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  status          String    @default("connected") // connected | permission_required | revoked | error
  lastError       String?
  connectedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Scheduling inputs for one interview stage. Availability entered by hand is stored here; free/busy
/// from Google is fetched on demand and never stored.
model InterviewScheduling {
  id                   String         @id @default(cuid())
  stageId              String         @unique
  kitId                String
  interviewerIdsJson   String         @default("[]")
  durationMins         Int            @default(60)
  dateFrom             String // YYYY-MM-DD in timeZone
  dateTo               String
  workStart            String         @default("09:00")
  workEnd              String         @default("17:00")
  timeZone             String         @default("UTC")
  candidateEmail       String?
  candidatePhone       String?
  candidateWindowsJson String         @default("[]") // [{ start, end }] ISO — what the candidate told the recruiter
  manualWindowsJson    String         @default("{}") // { userId: [{ start, end }] } — entered by the recruiter
  meetingMethod        String         @default("meet") // meet | phone | in_person | other
  locationNote         String?
  proposedSlotsJson    String         @default("[]") // times proposed to the candidate
  proposedVia          String? // email | whatsapp | manual
  proposedAt           DateTime?
  updatedByName        String         @default("")
  updatedAt            DateTime       @updatedAt
  stage                InterviewStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

/// A scheduled interview. Live events mirror a Google Calendar event; demo events are simulated.
model InterviewEvent {
  id              String         @id @default(cuid())
  orgId           String
  kitId           String
  stageId         String
  requestKey      String         @unique // idempotency: a retried "Schedule" never creates a second event
  mode            String // live | demo
  organizerUserId String
  organizerEmail  String?
  calendarId      String         @default("primary")
  googleEventId   String?
  status          String         @default("scheduled") // scheduled | cancelled | error
  startAt         DateTime
  endAt           DateTime
  timeZone        String
  attendeesJson   String         @default("[]") // [{ email, name, kind: candidate|interviewer, responseStatus? }]
  meetUrl         String?
  meetStatus      String? // created | pending | unavailable | not_requested
  htmlLink        String?
  meetingMethod   String         @default("meet")
  locationNote    String?
  lastError       String?
  createdByName   String
  updatedByName   String?
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  stage           InterviewStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([stageId, status])
}

/// One version of a role's scoring settings. Every profile score records the version that
/// produced it; changing settings creates a new version and never rewrites old scores.
model ScoringVersion {
  id              String         @id @default(cuid())
  orgId           String
  roleId          String
  version         Int
  bandsJson       String // [{ key: red|yellow|green, min, label }] ordered, contiguous 0–100
  weightRequired  Int
  weightPreferred Int
  minCoverage     Float          @default(0.6) // below this weighted coverage → Insufficient evidence
  note            String?
  createdById     String?
  createdByName   String
  createdAt       DateTime       @default(now())
  flaggedAt       DateTime? // set when monitoring found a material difference
  flagReason      String?
  flagReviewedAt  DateTime?
  flagReviewedBy  String?
  flagNote        String?
  role            Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scores          ProfileScore[]

  @@unique([roleId, version])
  @@index([orgId])
}

/// A stored 0–100 profile score for one assessment under one scoring version. Append-only:
/// corrections and deliberate recalculations add rows; history is never rewritten.
model ProfileScore {
  id               String         @id @default(cuid())
  orgId            String
  roleId           String
  applicationId    String
  assessmentId     String
  scoringVersionId String
  score            Int? // null when evidence is insufficient or the alternative route is used
  coverage         Float
  status           String // ok | insufficient | alternative
  band             String? // red | yellow | green
  bandLabel        String?
  breakdownJson    String // rows used in the calculation
  trigger          String // assessment | correction | recalculated
  createdById      String?
  createdByName    String
  createdAt        DateTime       @default(now())
  assessment       Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scoringVersion   ScoringVersion @relation(fields: [scoringVersionId], references: [id], onDelete: Cascade)

  @@index([orgId, roleId])
  @@index([applicationId, createdAt])
  @@index([scoringVersionId])
}

/// Self-reported demographic data for AGGREGATE fairness monitoring only. Kept apart from
/// candidate records and scoring; visible to admins only, in aggregate, with small groups suppressed.
model DemographicRecord {
  id            String    @id @default(cuid())
  orgId         String
  candidateId   String
  category      String // e.g. gender, ethnicity, age_band — as defined by the employer's lawful process
  value         String
  source        String    @default("self_reported")
  collectedAt   DateTime?
  createdByName String
  createdAt     DateTime  @default(now())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, category])
  @@index([orgId, category])
}

/// A recording or transcript an interviewer brought into Talyn for one interview stage, after the
/// organisation's consent process. Talyn never records meetings itself and keeps no audio: an
/// uploaded recording is sent to the configured transcription provider and discarded.
model InterviewRecording {
  id            String                @id @default(cuid())
  orgId         String
  kitId         String
  stageId       String
  source        String // audio_upload | transcript_import
  fileName      String
  provider      String // e.g. openai:whisper-1 | import:vtt | import:srt | import:text
  status        String // transcribing | transcribed | failed | deleted
  error         String?
  durationMs    Int?
  // Consent: who confirmed the organisation's process was followed, how, and when.
  consentMethod String // e.g. verbal_at_start | written | policy_notice
  consentNote   String?
  consentByName String
  consentById   String?
  consentAt     DateTime
  analysisModel String? // AI used for summary/evidence, when run
  analyzedAt    DateTime?
  createdByName String
  createdAt     DateTime              @default(now())
  stage         InterviewStage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  segments      TranscriptSegment[]
  insights      ConversationInsight[]

  @@index([orgId, kitId])
}

/// One timestamped passage. Text and speaker can be corrected; the original is kept.
model TranscriptSegment {
  id           String             @id @default(cuid())
  recordingId  String
  idx          Int
  startMs      Int
  endMs        Int
  speaker      String // label from the source, e.g. "Speaker 1" or a name in the imported file
  speakerRole  String             @default("unknown") // interviewer | candidate | unknown — set by a reviewer
  text         String
  originalText String
  editedByName String?
  editedAt     DateTime?
  speakerSetBy String? // who last set or renamed this passage's speaker (separate from text corrections)
  speakerSetAt DateTime?
  recording    InterviewRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId, idx])
}

/// An AI suggestion from a transcript, always linked to the passages it rests on. Nothing here is
/// a rating, a decision or submitted feedback until a person acts on it.
model ConversationInsight {
  id                String             @id @default(cuid())
  recordingId       String
  kind              String // summary | evidence | coverage | follow_up
  competencyId      String?
  competencyName    String?
  criterionId       String?
  coverage          String? // discussed | not_discussed | unclear (kind = coverage)
  text              String
  quote             String?
  segmentIdsJson    String             @default("[]")
  status            String             @default("suggested") // suggested | accepted | edited | dismissed
  editedText        String?
  reviewedByName    String?
  reviewedAt        DateTime?
  usedInScorecardBy String?
  usedInScorecardAt DateTime?
  createdAt         DateTime           @default(now())
  recording         InterviewRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId, kind])
}
