// Talyn In-house TA — data model (Phase 1 recruiting workspace + Phase 2 sourcing & outreach).
// Every business record carries `orgId`; all reads/writes are scoped by it on the server.
// Enum-like fields are strings; allowed values live in src/lib/domain.ts and are validated with zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Migrations run with DATABASE_URL_UNPOOLED when it is set (Neon); see the vercel-build script.
  url      = env("DATABASE_URL")
}

model Organization {
  id            String       @id @default(cuid())
  name          String
  retentionDays Int? // candidates inactive for longer are eligible for deletion; null = keep until deleted
  atsLinkedAt   DateTime? // set when an admin links this workspace to the configured ATS (one workspace per ATS)
  atsLinkedBy   String?
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  sessions      Session[]
  roles         Role[]
  candidates    Candidate[]
  atsSyncRuns   AtsSyncRun[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String? // null for accounts that sign in with Google only
  googleSub    String?      @unique // Google account id ("sub" claim)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String       @default("admin") // admin | recruiter
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// A verified Google identity waiting for its workspace to be created (new users only).
model PendingSignup {
  id        String   @id // sha256 of the cookie token
  googleSub String
  email     String
  name      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String       @id // sha256 of the cookie token; the raw token is never stored
  userId    String
  orgId     String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id               String           @id @default(cuid())
  orgId            String
  title            String
  department       String           @default("")
  location         String           @default("")
  employmentType   String           @default("full_time")
  description      String           @default("")
  status           String           @default("draft") // draft | open | on_hold | closed
  criteriaVersion  Int              @default(1) // bumped whenever the approved criteria set changes
  extractionStatus String? // null | needs_review | reviewed (when created from an uploaded JD)
  atsExternalId    String? // job/requisition id in the connected ATS
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  criteria         Criterion[]
  applications     Application[]
  documents        JobDescription[]
  extracted        ExtractedField[]
  icps             Icp[]
  searches         SearchStrategy[]
  questions        Question[]
  atsStageMaps     AtsStageMap[]

  @@index([orgId])
}

// An uploaded job description (PDF/DOCX) with its extracted per-page text.
model JobDescription {
  id            String              @id @default(cuid())
  orgId         String
  roleId        String
  fileName      String
  mimeType      String
  sizeBytes     Int
  pagesJson     String // JSON string[]: extracted text per page
  parserVersion String
  isCurrent     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  role          Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  file          JobDescriptionFile?

  @@index([orgId, roleId])
}

model JobDescriptionFile {
  id    String         @id @default(cuid())
  jdId  String         @unique
  orgId String
  data  Bytes
  jd    JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
}

// A single fact extracted from a JD or CV, with its source and review state.
model ExtractedField {
  id               String     @id @default(cuid())
  orgId            String
  subjectType      String // role | candidate
  roleId           String?
  candidateId      String?
  documentId       String? // JobDescription.id or Resume.id it came from
  field            String // e.g. title, location, email, work_history, skill
  valueJson        String // extracted value (string or object)
  editedValueJson  String? // recruiter-corrected value
  correctionReason String? // why the recruiter corrected it (see CORRECTION_REASONS)
  sourceQuote      String?
  sourcePage       Int?
  sourceSection    String?
  verified         Boolean    @default(false) // sourceQuote found in the document text
  status           String     @default("pending") // pending | accepted | edited | rejected
  extractor        String // e.g. "ai:openai:gpt-5.5/jd-extract-v1", "parser:jd-heuristic-v1"
  reviewedByName   String?
  reviewedAt       DateTime?
  position         Int        @default(0)
  createdAt        DateTime   @default(now())
  role             Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  candidate        Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([orgId, roleId])
  @@index([orgId, candidateId])
}

model Criterion {
  id                  String           @id @default(cuid())
  orgId               String
  roleId              String
  name                String
  description         String           @default("")
  importance          String           @default("essential") // essential | preferred
  priority            Int?
  origin              String           @default("manual") // manual | ai | extracted
  originalName        String? // wording as first proposed (AI or extraction), for edit comparison
  originalDescription String?
  edited              Boolean          @default(false)
  sourceText          String? // excerpt of the job description this came from
  sourcePage          Int?
  sourceSection       String?
  rationale           String?
  status              String           @default("proposed") // proposed | approved | rejected
  approvedById        String?
  approvedAt          DateTime?
  position            Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  role                Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assessmentItems     AssessmentItem[]

  @@index([orgId, roleId])
}

model Candidate {
  id               String           @id @default(cuid())
  orgId            String
  fullName         String
  email            String?
  phone            String?
  location         String?
  linkedinUrl      String?
  currentTitle     String?
  currentCompany   String?
  candidateSummary String? // information provided by the candidate (e.g. application answers)
  source           String           @default("manual") // manual | csv | cv_upload
  fieldOriginsJson String           @default("{}") // { fieldName: "cv" | "cv_corrected" | "recruiter" }
  extractionStatus String? // null | needs_review | reviewed (when a CV extraction awaits review)
  contactOptOut    Boolean          @default(false) // candidate asked not to be contacted: blocks all outreach
  optOutAt         DateTime?
  atsExternalId    String? // id in the connected ATS (set by ATS sync)
  atsSyncedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resumes          Resume[]
  notes            Note[]
  applications     Application[]
  extracted        ExtractedField[]
  atsConflicts     AtsConflict[]

  @@index([orgId])
  @@index([orgId, email])
}

model Resume {
  id            String       @id @default(cuid())
  orgId         String
  candidateId   String
  fileName      String
  mimeType      String
  sizeBytes     Int          @default(0)
  hasFile       Boolean      @default(false) // true when the original upload is stored in ResumeFile
  parserVersion String       @default("text-v1")
  pagesJson     String // JSON string[] of extracted text, one entry per page
  isCurrent     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  file          ResumeFile? // original upload; null when the resume was pasted as text
  assessments   Assessment[]

  @@index([orgId, candidateId])
}

// Original resume bytes, kept in a separate table so normal resume queries never load them.
// Stored in Postgres (private, deleted with the resume) — no public file storage involved.
model ResumeFile {
  id       String @id @default(cuid())
  resumeId String @unique
  orgId    String
  data     Bytes
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Note {
  id          String    @id @default(cuid())
  orgId       String
  candidateId String
  roleId      String?
  authorId    String?
  authorName  String    @default("")
  body        String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([orgId, candidateId])
}

// A candidate's association with a role, and their place in that role's pipeline.
model Application {
  id             String             @id @default(cuid())
  orgId          String
  candidateId    String
  roleId         String
  stage          String             @default("new")
  decision       String? // advance | hold | decline — always recorded by a recruiter
  decisionNote   String?
  decidedById    String?
  decidedByName  String?
  decidedAt      DateTime?
  priority       Int                @default(0) // recruiter override: 1 high, 0 normal, -1 low. Never changes the stage.
  priorityNote   String?
  priorityByName String?
  priorityAt     DateTime?
  atsExternalId  String? // application id in the connected ATS
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  role           Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  stageEvents    StageEvent[]
  assessments    Assessment[]
  tasks          Task[]
  outreach       OutreachSequence[]
  questions      Question[]
  atsOutbox      AtsOutbox[]

  @@unique([candidateId, roleId])
  @@index([orgId, roleId])
}

model StageEvent {
  id            String      @id @default(cuid())
  orgId         String
  applicationId String
  fromStage     String?
  toStage       String
  actorId       String?
  actorName     String      @default("")
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Assessment {
  id                       String           @id @default(cuid())
  orgId                    String
  applicationId            String
  resumeId                 String?
  generator                String // "ai" | "keyword" | "manual"
  model                    String? // model id when generator = ai
  criteriaSnapshot         String // JSON: [{id, updatedAt}] of the approved criteria used
  criteriaVersion          Int?
  engineVersion            String? // assessment prompt/logic version
  parserVersion            String? // resume text parser version
  scoreJson                String? // score breakdown at generation time (see src/lib/score.ts)
  recommendation           String? // advance_to_review | gather_more_info | insufficient_evidence
  recommendationJson       String? // { rationale, criteriaCited[], questions[], adjustedNote }
  recommendationStatus     String? // pending | accepted | edited | overridden
  finalRecommendation      String?
  recommendationNote       String?
  recommendationReviewedBy String?
  recommendationReviewedAt DateTime?
  status                   String           @default("needs_review") // needs_review | reviewed
  createdById              String?
  reviewedById             String?
  reviewedByName           String?
  reviewedAt               DateTime?
  createdAt                DateTime         @default(now())
  application              Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume                   Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  items                    AssessmentItem[]

  @@index([orgId, applicationId])
}

model AssessmentItem {
  id             String     @id @default(cuid())
  assessmentId   String
  criterionId    String?
  criterionName  String // snapshot so history survives criterion edits
  importance     String
  result         String // supported | partially_supported | inferred | conflicting | not_stated
  evidenceJson   String     @default("[]") // JSON: [{quote, source, page, section, verified}]
  explanation    String     @default("")
  missingInfo    String     @default("")
  confidence     String? // high | medium | low
  overrideResult String? // recruiter correction
  overrideNote   String?
  overriddenBy   String?
  overriddenAt   DateTime?
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion      Criterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
}

// Append-only record of meaningful actions (access, export, assessment, decision, outreach…).
// metaJson holds ids and counts only — never candidate personal data or document text.
model AuditEvent {
  id            String   @id @default(cuid())
  orgId         String
  actorId       String?
  actorName     String   @default("")
  action        String // e.g. candidate.viewed, resume.downloaded, export.pipeline, assessment.run
  subjectType   String // candidate | role | application | assessment | outreach | sourcing | org
  subjectId     String?
  roleId        String?
  candidateId   String?
  applicationId String?
  metaJson      String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, candidateId])
  @@index([orgId, action])
}

// Recruiter tasks, e.g. "Gather more information". Completing or cancelling a task never
// records a hiring decision.
model Task {
  id             String      @id @default(cuid())
  orgId          String
  applicationId  String
  type           String // gather_info | send_outreach
  title          String
  detailsJson    String      @default("{}") // { questions: string[], criteria: string[], messageId? }
  status         String      @default("open") // open | done | cancelled
  dueAt          DateTime?
  createdById    String?
  createdByName  String      @default("")
  resolvedNote   String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([applicationId])
}

// Ideal Candidate Profile: the recruiter-approved description of who to look for. Versioned;
// only an approved version drives sourcing. Ambiguity becomes clarification questions, never filters.
model Icp {
  id                 String    @id @default(cuid())
  orgId              String
  roleId             String
  version            Int
  status             String    @default("draft") // draft | approved | superseded
  generator          String // e.g. "ai:openai:gpt-5.5/icp-v1", "parser:icp-from-criteria-v1"
  criteriaVersion    Int
  clarificationsJson String    @default("[]") // [{ question, why, answer? }]
  approvedByName     String?
  approvedAt         DateTime?
  createdByName      String    @default("")
  createdAt          DateTime  @default(now())
  role               Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  items              IcpItem[]

  @@unique([roleId, version])
  @@index([orgId, roleId])
}

model IcpItem {
  id          String  @id @default(cuid())
  icpId       String
  category    String // see ICP_CATEGORIES in src/lib/domain.ts
  value       String
  origin      String // jd | criteria | ai_inferred | recruiter
  rationale   String?
  sourceQuote String?
  sourcePage  Int?
  status      String  @default("proposed") // proposed | approved | rejected
  edited      Boolean @default(false)
  position    Int     @default(0)
  icp         Icp     @relation(fields: [icpId], references: [id], onDelete: Cascade)

  @@index([icpId])
}

// A saved, versioned search plan for a role, derived from an approved ICP (+ optional
// plain-language request). Filters and Boolean are recruiter-editable.
model SearchStrategy {
  id               String      @id @default(cuid())
  orgId            String
  roleId           String
  icpId            String
  icpVersion       Int
  version          Int
  request          String      @default("") // recruiter's plain-language request
  filtersJson      String // { titles, skills_required, skills_preferred, locations, seniority, industries, exclusions }
  booleanQuery     String      @default("")
  mappingJson      String      @default("[]") // [{ phrase, field, value, note }]
  explanationsJson String      @default("[]") // [{ term, why }]
  planJson         String      @default("{}") // { target_titles, adjacent_profiles, company_contexts, notes }
  generator        String
  createdByName    String      @default("")
  createdAt        DateTime    @default(now())
  role             Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  runs             SearchRun[]

  @@unique([roleId, version])
  @@index([orgId, roleId])
}

model SearchRun {
  id             String           @id @default(cuid())
  orgId          String
  roleId         String
  strategyId     String
  source         String // connector key, e.g. "talyn"
  status         String // completed | failed | setup_required
  query          String           @default("") // the source-specific query actually used
  resultCount    Int              @default(0)
  excludedCount  Int              @default(0)
  estimatedTotal Int? // only when the source provides one
  error          String?
  createdByName  String           @default("")
  createdAt      DateTime         @default(now())
  strategy       SearchStrategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  results        SourcedProfile[]

  @@index([orgId, roleId])
}

// A candidate profile returned by an authorized source for a specific run. Facts keep
// field-level provenance; match signals are evidence-backed and never an assessment.
model SourcedProfile {
  id                   String    @id @default(cuid())
  orgId                String
  roleId               String
  runId                String
  source               String
  sourceRecordId       String // id in the source system (for Talyn rediscovery: the candidate id)
  sourceUrl            String?
  retrievedAt          DateTime  @default(now())
  displayName          String
  currentTitle         String?
  currentCompany       String?
  location             String?
  fieldsJson           String    @default("{}") // { field: { value, source, asOf } }
  signalsJson          String    @default("[]") // [{ category, term, matched, quote, page }]
  matchedSignals       Int       @default(0)
  totalSignals         Int       @default(0)
  evidenceStatus       String    @default("ok") // ok | insufficient | stale
  staleReason          String?
  duplicateCandidateId String?
  duplicateReason      String?
  status               String    @default("new") // new | saved | dismissed | excluded
  excludedBy           String? // approved exclusion term that matched
  feedback             String? // useful | irrelevant
  feedbackReason       String?
  savedApplicationId   String?
  reviewedByName       String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  run                  SearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId, roleId, status])
  @@index([runId])
}

model OutreachTemplate {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  subject       String
  body          String // may contain {{first_name}} {{role_title}} {{company}} {{current_title}}
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
}

// A recruiter-approved, role-specific outreach sequence for one application. Nothing is
// sent unless a recruiter activates it; replies, opt-outs and bounces stop follow-ups.
model OutreachSequence {
  id              String    @id @default(cuid())
  orgId           String
  applicationId   String
  status          String    @default("draft") // draft | active | paused | stopped | completed
  stopReason      String? // replied | opted_out | bounced | recruiter
  activatedByName String?
  activatedAt     DateTime?
  createdByName   String    @default("")
  createdAt       DateTime  @default(now())

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    OutreachMessage[]
  events      OutreachEvent[]

  @@index([orgId, status])
  @@index([applicationId])
}

model OutreachMessage {
  id                  String           @id @default(cuid())
  orgId               String
  sequenceId          String
  applicationId       String
  step                Int
  delayDays           Int              @default(0) // after the previous step was sent
  subject             String
  body                String
  draftSubject        String // as first drafted (AI or template), to show recruiter edits
  draftBody           String
  personalizationJson String           @default("[]") // [{ key, label, value, source }]
  generator           String // ai:<provider>:<model>/outreach-v1 | template:<id> | recruiter
  status              String           @default("draft") // draft | approved | due | sent | delivered | replied | bounced | opted_out | cancelled
  approvedByName      String?
  approvedAt          DateTime?
  dueAt               DateTime?
  sentAt              DateTime?
  sentVia             String? // manual | <provider key>
  providerMessageId   String?
  toEmail             String?
  senderName          String?
  deliveredAt         DateTime? // only when the provider reports delivery
  createdAt           DateTime         @default(now())
  sequence            OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([sequenceId])
  @@index([providerMessageId])
}

model OutreachEvent {
  id                String           @id @default(cuid())
  orgId             String
  sequenceId        String
  messageId         String?
  type              String // drafted | approved | activated | paused | resumed | stopped | sent | delivered | replied | bounced | opted_out
  providerConfirmed Boolean          @default(false) // true only when the sending provider reported it
  note              String?
  actorName         String           @default("")
  createdAt         DateTime         @default(now())
  sequence          OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
}

// Recruiter questions tied to a role criterion. Core questions (applicationId = null) are the
// same for every candidate in the role; follow-ups are candidate-specific and tied to an
// evidence gap or quote. Never sent to candidates automatically.
model Question {
  id            String       @id @default(cuid())
  orgId         String
  roleId        String
  criterionId   String?
  criterionName String
  applicationId String?
  kind          String // core | follow_up
  text          String
  rationale     String       @default("")
  evidenceJson  String       @default("{}") // { gap?: string, quote?: string, page?: number }
  origin        String // ai | template | recruiter
  generator     String       @default("")
  status        String       @default("proposed") // proposed | approved | rejected
  createdByName String       @default("")
  createdAt     DateTime     @default(now())
  role          Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, roleId])
  @@index([applicationId])
}

// ── ATS sync (dormant until an ATS connector is configured) ──────────────────

model AtsSyncRun {
  id          String       @id @default(cuid())
  orgId       String
  connector   String
  kind        String // pull | push
  status      String // running | completed | partial | failed
  created     Int          @default(0)
  updated     Int          @default(0)
  unchanged   Int          @default(0)
  conflicts   Int          @default(0)
  errorsJson  String       @default("[]") // [{ externalId?, message }] — no candidate data
  triggeredBy String       @default("") // cron | <user name>
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
}

/// A field where the ATS and Talyn disagree and Talyn would not overwrite a recruiter's value.
model AtsConflict {
  id             String    @id @default(cuid())
  orgId          String
  candidateId    String
  externalId     String
  field          String
  talynValue     String
  atsValue       String
  status         String    @default("open") // open | kept_talyn | used_ats
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([candidateId])
}

/// Per-role mapping of Talyn stages to ATS stages. atsStage null = not synced.
model AtsStageMap {
  id         String  @id @default(cuid())
  orgId      String
  roleId     String
  talynStage String
  atsStage   String?
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, talynStage])
  @@index([orgId])
}

/// Recruiter-made stage changes waiting to be pushed to the ATS. Retried with backoff.
model AtsOutbox {
  id            String      @id @default(cuid())
  orgId         String
  applicationId String
  roleId        String
  talynStage    String
  atsStage      String
  status        String      @default("pending") // pending | sent | failed | skipped
  attempts      Int         @default(0)
  lastError     String?
  nextAttemptAt DateTime    @default(now())
  createdByName String      @default("")
  createdAt     DateTime    @default(now())
  sentAt        DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([status, nextAttemptAt])
}
