# Postgres. Locally, `docker compose up -d` provides this database.
# On Vercel, adding a Neon database from the Marketplace sets both variables automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talyn"          # pooled connection (app)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/talyn" # direct connection (migrations)

# Optional. Enables AI-proposed criteria and AI candidate assessments (Claude).
# Without it, Talyn runs with clearly labeled non-AI helpers only.
ANTHROPIC_API_KEY=""
# Optional model override. Defaults to claude-opus-5-5.
TALYN_AI_MODEL=""
