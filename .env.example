# Database. SQLite for local development; use a postgresql:// URL in production
# (and change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Where uploaded resumes are stored (outside the public web root).
STORAGE_DIR="./storage"

# Optional. Enables AI-proposed criteria and AI candidate assessments (Claude).
# Without it, Talyn runs with clearly labeled non-AI helpers only.
ANTHROPIC_API_KEY=""
# Optional model override. Defaults to claude-opus-5-5.
TALYN_AI_MODEL=""
