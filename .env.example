# Postgres. Locally, `docker compose up -d` provides this database.
# On Vercel, adding Prisma Postgres or Neon from Storage sets DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talyn"
# Optional: direct (non-pooled) connection used for migrations when DATABASE_URL is pooled (Neon sets this).
# DATABASE_URL_UNPOOLED=""

# Optional AI provider (enables AI-proposed criteria and AI candidate assessments).
# Set ONE of these keys. Without any key, Talyn runs with clearly labeled non-AI helpers only.
OPENAI_API_KEY=""
OPENAI_MODEL=""        # default: gpt-5.5
ANTHROPIC_API_KEY=""
TALYN_AI_MODEL=""      # Anthropic model, default: claude-opus-5-5
# If both keys are set, Anthropic is used unless you set AI_PROVIDER="openai".
AI_PROVIDER=""

# Optional. Enables "Continue with Google" (create an OAuth client in Google Cloud Console).
# Authorized redirect URI: <your app URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: only allow Google accounts from these email domains (comma-separated), e.g. "acme.com"
GOOGLE_ALLOWED_DOMAINS=""
# Recommended in production: your public URL, so the Google redirect URI is always exact.
APP_URL=""

# Scheduled jobs (retention, outreach sending, ATS sync). Vercel sends this automatically to crons.
CRON_SECRET=""

# ── Integrations: each stays OFF until all of its required variables are set ──
# See docs/INTEGRATIONS.md and Settings → Integrations (which shows set/missing, never values).

# Email sending via SMTP (Google Workspace, Microsoft 365, SES, SendGrid, Postmark, Mailgun…)
SMTP_HOST=""
SMTP_PORT=""            # default 587 (STARTTLS); 465 for implicit TLS
SMTP_USER=""
SMTP_PASS=""
OUTREACH_FROM_EMAIL=""  # e.g. "Acme Talent <talent@acme.com>"
OUTREACH_REPLY_TO=""    # optional; defaults to the sender
OUTREACH_SECRET=""      # random string; signs unsubscribe links
EMAIL_WEBHOOK_SECRET="" # optional; bearer token for delivered/bounced/replied events

# Sourcing provider (licensed API implementing the Talyn sourcing contract)
SOURCING_PROVIDER_NAME=""
SOURCING_API_URL=""     # https://…
SOURCING_API_KEY=""

# ATS (implementing the Talyn ATS contract, directly or through an adapter)
ATS_NAME=""
ATS_API_URL=""          # https://…
ATS_API_KEY=""
ATS_PUSH_STAGES=""      # "true" to push recruiter stage changes (needs write access)

# WhatsApp Business Platform (Cloud API). Sends your APPROVED template only; off until set.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE=""   # default en
WHATSAPP_TEMPLATE_PARAMS=""     # default first_name,role_title,company,recruiter_name (add message only if your template has a free-text field)
WHATSAPP_TEMPLATE_PREVIEW=""    # the approved template text with {{1}}, {{2}}… for previews
WHATSAPP_APP_SECRET=""          # verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=""        # webhook verification handshake

# Google Calendar interview scheduling (uses the same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as
# Google sign-in). Off — demo mode with sample availability — until all three are set.
# Add <APP_URL>/api/calendar/callback as an authorized redirect URI on the OAuth client.
TOKEN_ENCRYPTION_KEY=""        # 32+ random characters, e.g. `openssl rand -base64 48`; encrypts Google tokens at rest
GOOGLE_CALENDAR_ENABLED=""     # "true" once the Calendar API is enabled and the scopes are on the consent screen
