# Postgres. Locally, `docker compose up -d` provides this database.
# On Vercel, adding Prisma Postgres or Neon from Storage sets DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talyn"
# Optional: direct (non-pooled) connection used for migrations when DATABASE_URL is pooled (Neon sets this).
# DATABASE_URL_UNPOOLED=""

# Optional. Enables AI-proposed criteria and AI candidate assessments (Claude).
# Without it, Talyn runs with clearly labeled non-AI helpers only.
ANTHROPIC_API_KEY=""
# Optional model override. Defaults to claude-opus-5-5.
TALYN_AI_MODEL=""
